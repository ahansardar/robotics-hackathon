<?xml version="1.0"?>
<package format="3">
  <name>turtle_pursuit</name><version>1.0.0</version>
  <description>Autonomous two-robot pursuit and evasion for TurtleBot 4 Lite.</description>
  <maintainer email="team@example.com">IITBBS Robotics Team</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend><exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend><exec_depend>visualization_msgs</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend><exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>turtlebot4_gz_bringup</exec_depend>
  <exec_depend>irobot_create_msgs</exec_depend>
  <test_depend>ament_pytest</test_depend><test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
