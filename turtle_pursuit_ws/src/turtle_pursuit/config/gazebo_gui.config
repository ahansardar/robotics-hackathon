<?xml version="1.0"?>
<plugin filename="MinimalScene" name="Arena View">
  <gz-gui><title>Pursuit Arena — RED catches BLUE</title><property key="showTitleBar" type="bool">true</property></gz-gui>
  <engine>ogre2</engine><scene>scene</scene>
  <ambient_light>0.7 0.7 0.7</ambient_light><background_color>0.08 0.10 0.14</background_color>
  <camera_pose>0 0 12 0 1.5707 0</camera_pose>
</plugin>
<plugin filename="GzSceneManager" name="Scene Manager"><gz-gui><property key="visible" type="bool">false</property><property key="state" type="string">floating</property></gz-gui></plugin>
<plugin filename="InteractiveViewControl" name="View control"><gz-gui><property key="visible" type="bool">false</property><property key="state" type="string">floating</property></gz-gui></plugin>
<plugin filename="WorldControl" name="Play / Pause">
  <gz-gui><title>PLAY / PAUSE</title><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">true</property><property key="width" type="double">180</property><property key="height" type="double">90</property><property key="x" type="double">10</property><property key="y" type="double">45</property></gz-gui>
  <play_pause>true</play_pause><step>true</step><start_paused>false</start_paused>
</plugin>
<plugin filename="WorldStats" name="Match clock">
  <gz-gui><title>SIMULATION CLOCK</title><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">true</property><property key="width" type="double">280</property><property key="height" type="double">120</property><property key="x" type="double">200</property><property key="y" type="double">45</property></gz-gui>
  <sim_time>true</sim_time><real_time_factor>true</real_time_factor>
</plugin>
